NODE_ENV=development
PORT=3333
# Só o domínio do front pode chamar a API
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://agendamento:troque-por-uma-senha-forte@localhost:5432/agendamento
REDIS_URL=redis://:troque-por-outra-senha-forte@localhost:6379
APP_URL=http://localhost:5173

# Rode "npm run gerar-chaves" e cole as 3 linhas abaixo
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ENCRYPTION_KEY=

# Consulta de senhas vazadas (Have I Been Pwned)
HIBP_ENABLED=true

# Fase 6 — endereço público da API (o gateway manda o webhook para cá; https em produção)
# API_URL=https://api.seudominio.com.br
# Filas (expiração do sinal e lembretes) rodando dentro da API
WORKER_EMBUTIDO=true

# Fase 9 — imagens (logo, banner, fotos). Em produção use s3 (AWS S3, Cloudflare R2, MinIO).
ARMAZENAMENTO=local
# UPLOADS_DIR=./uploads
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<conta>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://imagens.seudominio.com.br
