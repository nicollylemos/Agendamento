{
  "name": "@agendamento/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.check.json",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "gerar-chaves": "tsx scripts/gerar-chaves.ts",
    "criar-admin": "tsx --env-file=.env scripts/criar-admin.ts",
    "test:db": "vitest run",
    "trava-agenda": "tsx scripts/trava-agenda.ts"
  },
  "dependencies": {
    "@agendamento/shared": "*",
    "@aws-sdk/client-s3": "^3.1151.0",
    "@prisma/client": "6.12.0",
    "argon2": "^0.45.1",
    "bullmq": "^5.81.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "luxon": "^3.7.2",
    "otplib": "^13.5.0",
    "pdfkit": "^0.20.2",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.3.1",
    "sharp": "^0.35.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.18.0",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "prisma": "6.12.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.4"
  }
}
